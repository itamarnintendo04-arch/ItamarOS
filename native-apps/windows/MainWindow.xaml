<Window x:Class="ItamarOS.Native.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="ItamarOS Native Demo 1.1" Width="1160" Height="720" MinWidth="720" MinHeight="450"
  Background="#0D1C36" Foreground="#EAF4FF" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Background="#182F58" LastChildFill="True" Margin="0,0,0,1">
      <Image Source="Assets/itamaros-logo.png" Width="48" Height="48" Margin="16,8"/>
      <TextBlock Text="ItamarOS 1.1 · Native Windows demo" FontWeight="Bold" FontSize="20"
                 VerticalAlignment="Center"/>
    </DockPanel>
    <ContentControl Grid.Row="1" x:Name="AppContent" Margin="18"/>
    <DockPanel Grid.Row="2" LastChildFill="True" Background="#132A50" MinHeight="62">
      <Button Content="☰ Apps" Click="ShowStart" Margin="8" Padding="14,8"
              ToolTip="Open all built-in apps"/>
      <Button Content="▢ Minimize" Click="MinimizeCurrent" Margin="2,8" Padding="10,8"
              ToolTip="Keep the app running in the taskbar"/>
      <Button Content="✕ Close" Click="CloseCurrent" Margin="2,8" Padding="10,8"
              ToolTip="Close the current app, not ItamarOS"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="TaskbarApps" Orientation="Horizontal" VerticalAlignment="Center" />
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
