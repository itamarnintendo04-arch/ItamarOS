[Unit]
Description=ItamarOS update check (notification only)
Documentation=https://github.com/itamarnintendo04-arch/ItamarOS

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/share/itamaros/update_check.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=%h/.cache/itamaros
TimeoutStartSec=35
